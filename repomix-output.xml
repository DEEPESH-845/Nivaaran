              ))}
              <tr className="border-t-2 border-ink bg-paper-sunk">
                <th scope="row" className="px-4 py-3 font-semibold text-ink">
                  {lang === "hi" ? "घर्षण स्कोर (0–10)" : "Friction score (0–10)"}
