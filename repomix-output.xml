                    {lang === "hi" ? "स्रोत देखें" : "View Source"}
                    <ExternalLink aria-hidden className="size-3.5 shrink-0" strokeWidth={1.8} />
                  </a>
                </div>
              </Card>
            </li>
          ))}
        </ul>
      </section>
    </div>
  );
}
