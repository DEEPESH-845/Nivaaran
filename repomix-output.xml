@import "tailwindcss";

/* ============================================================
   NIVAARAN DESIGN SYSTEM
   Civic instrument, not SaaS dashboard.
   Reference: government print stationery + editorial typography.
   Light theme, plus one deliberate 'night' act on the landing narrative.
   Not dark mode — a single designed section. See docs/DESIGN.md.
   ============================================================ */

@theme {
  /* ---- Typeface ---- */
  --font-sans: var(--font-inter), var(--font-noto-deva), ui-sans-serif, system-ui, sans-serif;
  --font-display: var(--font-instrument), var(--font-noto-deva), Georgia, serif;
  --font-mono: ui-monospace, "SF Mono", Menlo, monospace;

  /* ---- Surface: warm paper, not screen white ---- */
  --color-paper:        oklch(0.988 0.004 85);
  --color-paper-sunk:   oklch(0.966 0.006 85);
  --color-paper-raised: oklch(1 0 0);

  /* ---- Ink: near-black with a blue cast, like stamp ink ---- */
  --color-ink:      oklch(0.23 0.021 258);
  --color-ink-soft: oklch(0.40 0.018 258);
  --color-ink-mute: oklch(0.49 0.014 258);
  --color-ink-faint:oklch(0.535 0.010 258);

  /* ---- Rules & hairlines ---- */
  --color-line:       oklch(0.905 0.006 258);
  --color-line-soft:  oklch(0.945 0.005 258);
  --color-line-strong:oklch(0.635 0.010 258);

  /* ---- Primary: India-ink indigo. Trust without corporate blue ---- */
  --color-indigo-50:  oklch(0.965 0.014 268);
  --color-indigo-100: oklch(0.925 0.033 268);
  --color-indigo-200: oklch(0.855 0.062 268);
  --color-indigo-400: oklch(0.615 0.135 266);
  --color-indigo-500: oklch(0.520 0.155 266);
  --color-indigo-600: oklch(0.440 0.150 266);
  --color-indigo-700: oklch(0.370 0.128 266);
  --color-indigo-900: oklch(0.255 0.075 266);

  /* ---- Semantic: verdict colours. Muted, informational, never alarming ---- */
  /* blocked — terracotta, an Indian pigment, not a browser error red */
  --color-blocked-50:  oklch(0.966 0.017 45);
  --color-blocked-100: oklch(0.925 0.040 45);
  --color-blocked-200: oklch(0.865 0.070 43);
  --color-blocked-500: oklch(0.550 0.150 39);
  --color-blocked-700: oklch(0.455 0.126 38);

  /* caution — ochre */
  --color-caution-50:  oklch(0.975 0.024 88);
  --color-caution-100: oklch(0.940 0.055 88);
  --color-caution-200: oklch(0.885 0.088 86);
  --color-caution-500: oklch(0.700 0.125 78);
  --color-caution-700: oklch(0.520 0.100 72);

  /* clear — deep verdigris green */
  --color-clear-50:  oklch(0.966 0.018 160);
  --color-clear-100: oklch(0.925 0.042 160);
  --color-clear-200: oklch(0.860 0.072 158);
  --color-clear-500: oklch(0.545 0.108 158);
  --color-clear-700: oklch(0.415 0.086 158);

  /* ---- Type scale ---- */
  --text-2xs: 0.6875rem;  --text-2xs--line-height: 1rem;
  --text-xs:  0.75rem;    --text-xs--line-height: 1.125rem;
  --text-sm:  0.8125rem;  --text-sm--line-height: 1.25rem;
  --text-base:0.9375rem;  --text-base--line-height: 1.5rem;
  --text-md:  1rem;       --text-md--line-height: 1.6rem;
  --text-lg:  1.125rem;   --text-lg--line-height: 1.65rem;
  --text-xl:  1.375rem;   --text-xl--line-height: 1.8rem;
  --text-2xl: 1.75rem;    --text-2xl--line-height: 2.1rem;
  --text-3xl: 2.125rem;   --text-3xl--line-height: 2.4rem;
  --text-4xl: 2.75rem;    --text-4xl--line-height: 2.95rem;

  /* ---- Radii: squared-off, document-like ---- */
  --radius-ctl:  0.5rem;
  --radius-card: 0.75rem;
  --radius-lg:   1rem;

  /* ---- Motion ---- */
  --ease-out-soft: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-in-out-soft: cubic-bezier(0.65, 0, 0.35, 1);

  /* ---- Night: the dark narrative act. NOT dark mode — one designed section,
     the same surface as the notice bar, extended into a full-bleed scene. ---- */
  --color-night:        oklch(0.215 0.020 258);
  --color-night-rise:   oklch(0.268 0.022 258);
  --color-night-line:   oklch(0.350 0.020 258);
  --color-night-edge:   oklch(0.520 0.020 258);  /* 3.18:1 — interactive boundary */
  --color-night-ink:    oklch(0.975 0.004 85);   /* 16.30:1 */
  --color-night-soft:   oklch(0.855 0.010 258);  /* 11.27:1 */
  --color-night-faint:  oklch(0.712 0.014 258);  /*  6.86:1 */
  --color-signal:       oklch(0.800 0.100 268);  /*  9.30:1 — accent on night */

  /* Mid-tints for marks and diagram strokes on night */
  --color-blocked-300: oklch(0.790 0.105 41);    /*  8.75:1 on night */
  --color-clear-300:   oklch(0.775 0.095 158);   /*  8.95:1 on night */

  /* ---- Motion: one system. Never hand-tune a duration inline. ---- */
  --ease-entry:     cubic-bezier(0.16, 1, 0.30, 1);
  --ease-cinematic: cubic-bezier(0.65, 0.02, 0.15, 1);

  --dur-instant:   120ms;
  --dur-fast:      240ms;
  --dur-medium:    420ms;
  --dur-slow:      680ms;
  --dur-cinematic: 1100ms;

}

/* Fluid display size for hero moments */
@layer base {
  :root {
    --text-display: clamp(2.125rem, 1.35rem + 3.4vw, 3.75rem);
    --shadow-card: 0 1px 2px oklch(0.23 0.021 258 / 0.05);
    --shadow-lift: 0 1px 2px oklch(0.23 0.021 258 / 0.06),
                   0 8px 24px -12px oklch(0.23 0.021 258 / 0.18);
    --shadow-sheet: 0 -8px 40px -12px oklch(0.23 0.021 258 / 0.22);
  }

  * { border-color: var(--color-line); }

  html {
    -webkit-text-size-adjust: 100%;
    /* No `scroll-behavior: smooth`. The browser's smooth scroll and Lenis
       would both be animating the same scroll position — that is the double
       smoothing that shows up as drift and overshoot on anchor jumps. Hash
       links are handled by Lenis instead (see SmoothScrollProvider). */
    /* `clip`, never `hidden`: hidden would make <html> a scroll container and
       break both the sticky header and every pinned ScrollTrigger. This is
       what stops a full-bleed 100vw band from adding a sideways scrollbar. */
    overflow-x: clip;
  }

  body {
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-feature-settings: "cv05" 1, "cv08" 1, "ss03" 1;
  }

  /* Visible focus everywhere. Never removed. */
  :focus-visible {
    outline: 2px solid var(--color-indigo-600);
    outline-offset: 2px;
    border-radius: 3px;
  }

  /* Tabular numerals wherever numbers must line up */
  .tnum { font-variant-numeric: tabular-nums; }

  ::selection {
    background: var(--color-indigo-100);
    color: var(--color-indigo-900);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

@layer components {
  .display {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: -0.022em;
    font-weight: 400;
  }

  /* Faint ruled-paper texture — reads as a form, costs nothing */
  .ruled {
    background-image: linear-gradient(
      to bottom,
      transparent calc(100% - 1px),
      var(--color-line-soft) calc(100% - 1px)
    );
    background-size: 100% 2rem;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
  }
  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border-radius: var(--radius-ctl);
  }
}

@keyframes rise {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: none; }
}
.animate-rise { animation: rise 0.32s var(--ease-out-soft) both; }

/* ============================================================
   NARRATIVE LAYER
   Only the landing story uses these. The journey stays quiet.
   Every scene has a designed *static* end-state: reduced motion
   tells the same story in stills, it does not switch it off.
   ============================================================ */

@layer components {

  /* ---- Full-bleed escape from the max-w-5xl column ---- */
  .bleed {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  /* ---- The night act ---- */
  .night {
    background-color: var(--color-night);
    color: var(--color-night-ink);
  }
  .night ::selection {
    background: var(--color-signal);
    color: var(--color-night);
  }
  .night :focus-visible { outline-color: var(--color-signal); }

  /* ---- Technical metadata voice, used across every scene ---- */
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Scene reveal. Driven by IntersectionObserver (see Reveal). ----
     Hidden state applies only when motion is welcome and scripting exists,
     so a reduced-motion or no-JS reader never sees an empty page. */
  [data-reveal] {
    transition:
      opacity var(--dur-slow) var(--ease-entry),
      transform var(--dur-slow) var(--ease-entry);
    transition-delay: var(--reveal-delay, 0ms);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal="pending"] {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
  }
  @media (scripting: none) {
    [data-reveal="pending"] { opacity: 1; transform: none; }
  }

  /* ---- The mismatch: one token, read by a machine ---- */
  .tok {
    position: relative;
    display: inline-block;
    border-radius: 4px;
    padding: 0.125rem 0.4rem;
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
    isolation: isolate;
  }
  .tok-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
  }
  .tok-fill--clear   { background: var(--color-clear-100);   box-shadow: inset 0 0 0 1px var(--color-clear-200); }
  .tok-fill--blocked { background: var(--color-blocked-100); box-shadow: inset 0 0 0 1px var(--color-blocked-200); }

  /* The read: a scan line crosses the record, tokens resolve behind it. */
  @media (prefers-reduced-motion: no-preference) {
    .scan .tok-fill { animation: tok-resolve var(--dur-fast) var(--ease-entry) both; }
    .scan .tok-fill { animation-delay: calc(700ms + var(--i, 0) * 260ms); }
    .scan .tok-text { animation: tok-ink var(--dur-fast) var(--ease-entry) both; animation-delay: calc(700ms + var(--i, 0) * 260ms); }
    .scan-line { animation: scan-sweep 1900ms var(--ease-cinematic) both; animation-delay: 500ms; }
    .scan-track { container-type: inline-size; }
    .scan-verdict { animation: rise var(--dur-slow) var(--ease-entry) both; animation-delay: 1750ms; }
    .scan-stamp   { animation: stamp var(--dur-slow) var(--ease-entry) both; animation-delay: 2350ms; }
  }
  /* The reading head. Invisible unless it is actually sweeping. */
  .scan-line {
    position: absolute;
    top: -0.25rem;
    bottom: -0.25rem;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-blocked-500) 18%,
      var(--color-blocked-500) 82%,
      transparent
    );
    will-change: transform;
    opacity: 0;
  }

  /* Static end-state: the record is already read. */
  .tok-fill, .scan-verdict, .scan-stamp { opacity: 1; }

  @keyframes tok-resolve { from { opacity: 0; } to { opacity: 1; } }
  @keyframes tok-ink     { from { color: var(--color-ink-faint); } to { color: inherit; } }
  @keyframes scan-sweep {
    0%   { opacity: 0; transform: translate3d(0, 0, 0); }
    8%   { opacity: 1; }
    92%  { opacity: 1; }
    100% { opacity: 0; transform: translate3d(100cqw, 0, 0); }
  }
  @keyframes stamp {
    from { opacity: 0; transform: translate3d(0, 8px, 0) rotate(-1.5deg); }
    to   { opacity: 1; transform: none; }
  }

  /* ---- Scrubbed scenes read --p (0→1) written by useSceneProgress ---- */
  .scrub { --p: 0; }
}

/* ============================================================
   PRINT
   One screen in this product is meant to leave it on paper: the
   fix plan on /preflight, carried to an employer's HR desk or an
   EPFO counter. Everything that is navigation on screen is noise
   on paper — but the disclosure, the sources and the fix steps
   all have to survive.
   ============================================================ */
@media print {
  @page {
    margin: 14mm;
  }

  html,
  body {
    background: #fff;
    color: #000;
  }

  /* Cards read as ruled boxes; shadows and tints cost toner and clarity. */
  .rounded-card,
  .rounded-ctl {
    box-shadow: none !important;
  }

  /* Keeping a whole finding together costs half a sheet each time one does
     not fit, so protect the parts that are useless when split — the numbered
     fix steps and the record diff — and let the card itself flow. */
  ol,
  dl {
    break-inside: avoid;
  }
  h1,
  h2,
  h3 {
    break-after: avoid;
  }

  /* <details> cannot be opened by a media query, so unhide its contents
     directly. Both properties are needed: browsers differ on which one
     collapses a closed disclosure. A citation nobody can read is not a
     citation, so this is what puts the publisher, the date we checked it and
     the caveat onto the paper. */
  details::details-content {
    content-visibility: visible !important;
    block-size: auto !important;
  }
  /* Older engines collapse the children rather than the pseudo-element. */
  details > *:not(summary) {
    display: block !important;
    content-visibility: visible !important;
  }
  details > summary {
    min-height: 0;
    font-weight: 600;
  }
  details > summary > svg {
    display: none;
  }

  /* A printed link is dead unless it carries its address. */
  a[href^="http"]::after {
    content: " (" attr(href) ")";
    font-size: 0.75em;
    word-break: break-all;
  }

  /* Entry animations must not park content at opacity 0 on paper. */
  .animate-rise,
  .reveal {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}
